# Database
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password

# Auth — generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_a_strong_secret

# CORS — your domain(s), comma-separated
CORS_ORIGIN=https://yourdomain.com

# App port (Coolify will map this)
APP_PORT=80

# App public URL (used in email ticket links)
APP_URL=https://yourdomain.com

# Mail Campaign API
MAIL_API_BASE_URL=https://mail.example.com
MAIL_API_KEY=cms_...
MAIL_CAMPAIGN_CREATED_ID=1
MAIL_CAMPAIGN_UPDATED_ID=2
MAIL_CAMPAIGN_CREATED_STAFF_ID=3
