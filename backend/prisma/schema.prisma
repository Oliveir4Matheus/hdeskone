generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  password           String
  role               String    @default("colaborador")
  mustChangePassword Boolean   @default(true)
  tickets            Ticket[]  @relation("assigned")
  messages           Message[]
  createdAt          DateTime  @default(now())
}

model Ticket {
  id             Int          @id @default(autoincrement())
  title          String
  description    String
  priority       String       @default("medium")
  status         String       @default("open")
  type           String       @default("incidente")
  base           String       @default("GRU")
  ccEmails       String?
  requester      String
  requesterEmail String?
  assignedTo     User?        @relation("assigned", fields: [assignedId], references: [id])
  assignedId     Int?
  attachments    Attachment[]
  messages       Message[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([priority])
  @@index([assignedId])
  @@index([createdAt])
  @@index([type])
  @@index([base])
}

model Attachment {
  id        Int      @id @default(autoincrement())
  filename  String
  path      String
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model TicketStatus {
  id    Int    @id @default(autoincrement())
  name  String @unique
  color String @default("#6b7280")
  order Int    @default(0)
}
